#!/bin/bash
set -Eeuo pipefail

KAM_CFG=/etc/kamailio/kamailio.cfg
RTP_CFG=/etc/rtpengine/rtpengine.conf
STATE_DIR=/var/lib/goautodial-clone-sync
BACKUP_ROOT=/root/goautodial-backups/clone-sync
LOCK_FILE=/run/goautodial-clone-sync.lock
DRY_RUN=0
BOOT_MODE=0
REQUESTED_IP=""

usage() { echo "Usage: goautodial-clone-sync [--dry-run] [--boot] [--ip PUBLIC_IP]"; }
log() { echo "[clone-sync] $*"; logger -t goautodial-clone-sync -- "$*" 2>/dev/null || true; }
fail() { log "ERROR: $*"; exit 1; }

valid_ipv4() {
    local ip=$1 a b c d
    IFS=. read -r a b c d <<< "$ip"
    [[ -n "$a" && -n "$b" && -n "$c" && -n "$d" ]] || return 1
    [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ && "$c" =~ ^[0-9]+$ && "$d" =~ ^[0-9]+$ ]] || return 1
    (( a <= 255 && b <= 255 && c <= 255 && d <= 255 )) || return 1
    (( a > 0 && a < 224 )) || return 1
    [[ "$a" != 127 ]] || return 1
}

while (( $# )); do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --boot) BOOT_MODE=1 ;;
        --ip)
            shift
            [[ $# -gt 0 ]] || fail "--ip requires a value"
            REQUESTED_IP=$1
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage; fail "Unknown option: $1" ;;
    esac
    shift
done

[[ $EUID -eq 0 ]] || fail "Run as root"
for cmd in ip awk grep sed mysql mysqladmin mysqldump kamailio systemctl flock; do
    command -v "$cmd" >/dev/null || fail "Required command not found: $cmd"
done
[[ -f "$KAM_CFG" ]] || fail "Missing $KAM_CFG"
[[ -f "$RTP_CFG" ]] || fail "Missing $RTP_CFG"

exec 9>"$LOCK_FILE"
flock -n 9 || fail "Another clone-sync process is running"

if [[ -n "$REQUESTED_IP" ]]; then
    NEW_IP=$REQUESTED_IP
else
    NEW_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
fi
valid_ipv4 "$NEW_IP" || fail "Invalid detected IP: $NEW_IP"
ip -4 address show | grep -qw "$NEW_IP" || fail "IP is not assigned locally: $NEW_IP"

for attempt in {1..30}; do
    mysqladmin ping --silent >/dev/null 2>&1 && break
    (( attempt == 30 )) && fail "MariaDB is not ready"
    sleep 1
done

KAM_IP=$(sed -nE 's/^#!substdef "!MY_IP_ADDR!([^!]+)!g"$/\1/p' "$KAM_CFG" | head -n1)
RTP_IP=$(sed -nE 's/^[[:space:]]*interface[[:space:]]*=[[:space:]]*([^;[:space:]]+).*$/\1/p' "$RTP_CFG" | head -n1)
DB_IDENTITY=$(mysql -N -B -e "SELECT value FROM goautodial.settings WHERE setting='GO_agent_domain' LIMIT 1")
[[ -n "$DB_IDENTITY" ]] || fail "GO_agent_domain is empty"

IP_MODE=0
if valid_ipv4 "$DB_IDENTITY" || [[ "$DB_IDENTITY" == "NEW_PUBLIC_IP" ]]; then IP_MODE=1; fi

TARGET_IDENTITY=$DB_IDENTITY
if (( IP_MODE )); then TARGET_IDENTITY=$NEW_IP; fi

DB_MISMATCH=$(mysql -N -B -e "SELECT COUNT(*) FROM goautodial.settings WHERE setting IN ('base_url','GO_agent_domain','GO_agent_wss','GO_agent_wss_sip') AND value <> '$TARGET_IDENTITY'")
SUBSCRIBER_MISMATCH=$(mysql -N -B -e "SELECT COUNT(*) FROM kamailio.subscriber WHERE domain <> '$TARGET_IDENTITY'")

NEEDS_CHANGE=0
[[ "$KAM_IP" == "$NEW_IP" ]] || NEEDS_CHANGE=1
[[ "$RTP_IP" == "$NEW_IP" ]] || NEEDS_CHANGE=1
(( DB_MISMATCH == 0 )) || NEEDS_CHANGE=1
(( SUBSCRIBER_MISMATCH == 0 )) || NEEDS_CHANGE=1

log "Detected IP: $NEW_IP"
log "Kamailio IP: $KAM_IP"
log "RTPengine IP: $RTP_IP"
if (( IP_MODE )); then log "Identity mode: IP ($TARGET_IDENTITY)"; else log "Identity mode: domain ($TARGET_IDENTITY preserved)"; fi

if (( DRY_RUN )); then
    if (( NEEDS_CHANGE )); then log "Dry run: changes are required"; else log "Dry run: already synchronized"; fi
    exit 0
fi

if (( ! NEEDS_CHANGE )); then
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$NEW_IP" > "$STATE_DIR/last-ip"
    chmod 600 "$STATE_DIR/last-ip"
    log "No changes required"
    exit 0
fi

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="$BACKUP_ROOT/$STAMP"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR"
cp -a "$KAM_CFG" "$BACKUP_DIR/kamailio.cfg"
cp -a "$RTP_CFG" "$BACKUP_DIR/rtpengine.conf"
mysqldump --single-transaction --replace goautodial settings > "$BACKUP_DIR/goautodial-settings.sql"
mysqldump --single-transaction --replace kamailio subscriber location > "$BACKUP_DIR/kamailio-subscriber-location.sql"
chmod 600 "$BACKUP_DIR"/*.sql
log "Backup created: $BACKUP_DIR"

ROLLBACK_NEEDED=1
rollback() {
    local rc=$?
    if (( ROLLBACK_NEEDED )); then
        log "Failure detected; restoring backup"
        cp -a "$BACKUP_DIR/kamailio.cfg" "$KAM_CFG"
        cp -a "$BACKUP_DIR/rtpengine.conf" "$RTP_CFG"
        mysql goautodial < "$BACKUP_DIR/goautodial-settings.sql" || true
        mysql kamailio < "$BACKUP_DIR/kamailio-subscriber-location.sql" || true
        if (( ! BOOT_MODE )); then
            systemctl restart rtpengine || true
            systemctl restart kamailio || true
        fi
    fi
    exit "$rc"
}
trap rollback ERR INT TERM

sed -i -E "s|^#!substdef \"!MY_IP_ADDR![^!]+!g\"$|#!substdef \"!MY_IP_ADDR!$NEW_IP!g\"|" "$KAM_CFG"
grep -qF "#!substdef \"!MY_IP_ADDR!$NEW_IP!g\"" "$KAM_CFG"
sed -i -E "s|^[[:space:]]*interface[[:space:]]*=.*$|interface = $NEW_IP|" "$RTP_CFG"
grep -qE "^interface[[:space:]]*=[[:space:]]*$NEW_IP$" "$RTP_CFG"
kamailio -c -f "$KAM_CFG" -m 64 -M 8 >/dev/null

mysql --abort-source-on-error <<SQL
START TRANSACTION;
UPDATE goautodial.settings
SET value='$TARGET_IDENTITY'
WHERE setting IN ('base_url','GO_agent_domain','GO_agent_wss','GO_agent_wss_sip');
UPDATE kamailio.subscriber SET domain='$TARGET_IDENTITY';
DELETE FROM kamailio.location;
COMMIT;
SQL

if (( ! BOOT_MODE )); then
    systemctl restart rtpengine
    systemctl is-active --quiet rtpengine
    systemctl restart kamailio
    systemctl is-active --quiet kamailio
fi

mkdir -p "$STATE_DIR"
printf '%s\n' "$NEW_IP" > "$STATE_DIR/last-ip"
chmod 600 "$STATE_DIR/last-ip"
ROLLBACK_NEEDED=0
trap - ERR INT TERM
log "Clone synchronization completed successfully"
log "Self-signed WSS may require browser trust at https://$NEW_IP:4443"
